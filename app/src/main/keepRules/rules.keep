# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Keep Kotlin standard library classes from being stripped/obfuscated
-keep class kotlin.** { *; }
-dontwarn kotlin.**

# Keep Coroutines
-keep class kotlinx.coroutines.** { *; }
-dontwarn kotlinx.coroutines.**

# Keep Lifecycle, Startup & EmojiCompat to prevent IllegalAccessError
-keep class androidx.lifecycle.** { *; }
-keep class androidx.startup.** { *; }
-keep class androidx.emoji2.** { *; }
